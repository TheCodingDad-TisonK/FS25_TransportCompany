    <!-- ===================================================== -->
    <!-- Hints                                                  -->
    <!-- ===================================================== -->
    <text name="transportCompany_hintTitle">
        <en>Transport Company</en>
    </text>
    <text name="transportCompany_hintIntro">
        <en>You now run a transport company. Open the PDA and use the Transport Company page to accept freight contracts, dispatch your trucks and track your profit.</en>
    </text>
    <text name="transportCompany_gameplayHint">
        <en>Transport Company: accept freight contracts from the dispatch board in the PDA. Trucks earn revenue per job and fuel costs are charged to the truck's ledger. A truck is any vehicle classified as a truck in the base game; it needs a trailer to haul bulk or pallet freight.</en>
    </text>
    <text name="transportCompany_hint_dispatch">
        <en>Transport Company: accept freight contracts from the dispatch board in the PDA. Assign a truck or hire a driver to haul the load.</en>
    </text>
    <text name="transportCompany_hint_fleet">
        <en>Transport Company: your fleet's revenue, fuel costs, and profit are tracked per truck in the Fleet and Ledger tabs of the dispatch office.</en>
    </text>

