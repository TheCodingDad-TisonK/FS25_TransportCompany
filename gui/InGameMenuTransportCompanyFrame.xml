<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="ingameMenuTransportCompany">
	<!--
	  Two-panel layout, matching dataS/gui/InGameMenuContractsFrame.xml.

	  fs25_subCategoryContainer is only 410px wide, so the left list can
	  hold a title line plus two short values and nothing more. An
	  earlier version put five columns at 100/470/700/840px in here;
	  everything past 410px fell outside the panel, which is what made
	  the page look collapsed. Details belong in the content container
	  on the right.
	-->
	<ThreePartBitmap profile="fs25_subCategoryContainerBg">
		<Bitmap profile="fs25_subCategoryContainerArrow"/>
	</ThreePartBitmap>
	<Bitmap profile="fs25_subCategoryContainer">
		<!-- MultiTextOptionElement registers its callback from #onClick
		     (MultiTextOptionElement.lua:63); #onChange is not read. -->
		<MultiTextOption profile="fs25_subCategorySelector" id="subCategorySelector" onClick="onChangeSubCategory" focusInit="onOpen"/>
		<BoxLayout profile="fs25_subCategorySelectorBox" id="subCategoryDotBox"/>
		<RoundCorner profile="fs25_subCategorySelectorDot" id="subCategoryDotTemplate"/>
		<GuiElement profile="fs25_subCategoryListContainer" id="contractsListBox">
			<Bitmap profile="fs25_subCategoryStartClipper" name="startClipper"/>
			<Bitmap profile="fs25_subCategoryStopClipper" name="endClipper"/>
			<!-- Every ListItem needs a name: the cell database is keyed by
			     it (SmoothListElement.lua:255) and getCellTypeForItemInSection
			     returns that name to pick a row layout. -->
			<SmoothList profile="fs25_subCategoryList" id="contentList" onClick="onListSelectionChanged" startClipperElementName="startClipper" endClipperElementName="endClipper" emptyIndicatorId="noContractsText">
				<!--
				  ONE row layout for all three sub-tabs, deliberately.
				  With a cell type per tab, switching tabs made the list
				  swap cell types against a selection index left over
				  from the previous tab, which is why switching worked
				  only sometimes. A single layout removes the mismatch
				  entirely; the three tabs just fill the same slots.
				-->
				<ListItem profile="fs25_subCategoryListItem" name="row">
					<Bitmap profile="fs25_subCategoryListItemIcon" name="icon" imageSize="512 512"/>
					<Text profile="fs25_tcListPrimary" name="primary"/>
					<Text profile="fs25_tcListLeft" name="left"/>
					<Text profile="fs25_tcListRight" name="right"/>
				</ListItem>
			</SmoothList>
			<ThreePartBitmap profile="fs25_subCategoryListSliderBox">
				<Slider profile="fs25_listSlider" dataElementId="contentList"/>
			</ThreePartBitmap>
		</GuiElement>
	</Bitmap>

	<!-- The list's emptyIndicatorId resolves against the frame
	     (SmoothListElement.lua:238), so the element it names has to
	     exist somewhere in this GUI or the indicator is never shown. -->
	<GuiElement profile="fs25_menuContentContainer">
		<Text profile="fs25_tcEmptyText" id="noContractsText" text="$l10n_transportCompany_noHq"/>
	</GuiElement>

	<!-- Detail panel for whatever is selected on the left. -->
	<GuiElement profile="fs25_menuContentContainer" id="contentContainer">
		<GuiElement profile="fs25_tcDetailBox" id="detailBox">
			<Text profile="fs25_tcDetailTitle" id="detailTitle"/>
			<Text profile="fs25_tcDetailSubtitle" id="detailSubtitle"/>
			<SmoothList profile="fs25_tcDetailList" id="detailList">
				<ListItem profile="fs25_tcDetailItem" name="detailItem">
					<Text profile="fs25_tcDetailLabel" name="label"/>
					<Text profile="fs25_tcDetailValue" name="value"/>
				</ListItem>
			</SmoothList>
			<Text profile="fs25_tcProgressLabel" id="progressLabel"/>
			<ThreePartBitmap profile="fs25_tcProgressBg" id="progressBarBg">
				<ThreePartBitmap profile="fs25_tcProgressBar" id="progressBar"/>
			</ThreePartBitmap>
			<Text profile="fs25_tcRewardLabel" id="rewardLabel"/>
			<Text profile="fs25_tcRewardValue" id="rewardText"/>
		</GuiElement>
	</GuiElement>

	<GUIProfiles>
		<!-- left list rows: must stay inside 410px -->
		<!--
		  The row is inside fs25_subCategoryContainer, which is 410px
		  wide. Content starts at 100px and the right slot sits 38px in
		  from the edge, so roughly 270px is usable. Anything wider than
		  that is what was clamping the text.
		-->
		<Profile name="fs25_tcListPrimary" extends="fs25_textDarkHighlight" with="anchorTopLeft">
			<size value="268px 40px"/>
			<position value="100px -18px"/>
			<textSize value="24px"/>
			<textWrapWidth value="260px"/>
			<textMaxNumLines value="2"/>
		</Profile>
		<Profile name="fs25_tcListLeft" extends="fs25_textDarkHighlight" with="anchorBottomLeft">
			<size value="150px 28px"/>
			<position value="100px 38px"/>
			<textSize value="22px"/>
			<textVerticalAlignment value="bottom"/>
			<textColor value="$preset_fs25_colorMainHighlight"/>
			<textFocusedColor value="$preset_fs25_colorMainLight"/>
			<textHighlightedColor value="$preset_fs25_colorMainHighlight"/>
		</Profile>
		<Profile name="fs25_tcListRight" extends="fs25_textDarkHighlight" with="anchorBottomRight">
			<size value="150px 28px"/>
			<position value="-38px 38px"/>
			<textSize value="22px"/>
			<textAlignment value="right"/>
		</Profile>

		<!-- right detail panel -->
		<!--
		  Sat at 500px, which pushed the panel hard against the right
		  edge and left a wide dead strip between it and the list.
		  Centred in the space the list leaves instead.
		-->
		<Profile name="fs25_tcDetailBox" extends="emptyPanel" with="anchorTopLeft">
			<size value="900px 700px"/>
			<position value="170px 0px"/>
		</Profile>
		<Profile name="fs25_tcDetailTitle" extends="fs25_textDefault" with="anchorTopStretchingX">
			<size value="100% 64px"/>
			<position value="0px -20px"/>
			<textSize value="32px"/>
			<textBold value="true"/>
			<textUpperCase value="true"/>
			<textAlignment value="center"/>
			<textColor value="$preset_fs25_colorMainHighlight"/>
			<textWrapWidth value="840px"/>
			<textMaxNumLines value="2"/>
		</Profile>
		<Profile name="fs25_tcDetailSubtitle" extends="fs25_textGrey" with="anchorTopStretchingX">
			<size value="100% 56px"/>
			<position value="0px -84px"/>
			<textSize value="24px"/>
			<textAlignment value="center"/>
			<!-- Setting descriptions are a full sentence and must wrap,
			     not clip to one line. -->
			<textWrapWidth value="840px"/>
			<textMaxNumLines value="2"/>
		</Profile>
		<Profile name="fs25_tcDetailList" extends="emptyPanel" with="anchorTopCenter">
			<size value="100% 260px"/>
			<absoluteSizeOffset value="40px 0px"/>
			<position value="0px -148px"/>
			<handleFocus value="false"/>
		</Profile>
		<Profile name="fs25_tcDetailItem" extends="baseReference" with="anchorTopStretchingX alternating">
			<height value="44px"/>
			<imageColor value="$preset_fs25_colorGrey"/>
			<alternateBackgroundColor value="$preset_fs25_colorGreyDark_50"/>
		</Profile>
		<Profile name="fs25_tcDetailLabel" extends="fs25_textDefault" with="anchorTopLeft">
			<size value="50% 44px"/>
			<textOffset value="14px 0px"/>
			<textWrapWidth value="400px"/>
			<textMaxNumLines value="2"/>
		</Profile>
		<Profile name="fs25_tcDetailValue" extends="fs25_textDefault" with="anchorTopRight">
			<size value="50% 44px"/>
			<textBold value="true"/>
			<textAlignment value="right"/>
			<textOffset value="-14px 0px"/>
			<textColor value="$preset_fs25_colorMainHighlight"/>
			<textWrapWidth value="400px"/>
			<textMaxNumLines value="2"/>
		</Profile>
		<Profile name="fs25_tcProgressLabel" extends="fs25_textDefault" with="anchorTopCenter">
			<size value="820px 30px"/>
			<position value="0px -440px"/>
			<textBold value="true"/>
			<textUpperCase value="true"/>
		</Profile>
		<Profile name="fs25_tcProgressBg" extends="emptyPanel" with="anchorTopCenter">
			<size value="820px 33px"/>
			<position value="0px -476px"/>
			<imageColor value="$preset_fs25_colorGrey"/>
			<imageSliceId value="gui.contracts_progressbar_background_middle"/>
			<startImageSize value="8px 0"/>
			<startImageSliceId value="gui.contracts_progressbar_background_left"/>
			<endImageSize value="8px 0"/>
			<endImageSliceId value="gui.contracts_progressbar_background_right"/>
		</Profile>
		<Profile name="fs25_tcProgressBar" extends="baseReference" with="anchorMiddleLeft">
			<size value="812px 25px"/>
			<position value="4px 0px"/>
			<imageColor value="$preset_fs25_colorMainHighlight"/>
			<imageSliceId value="gui.button_middle"/>
			<startImageSize value="6px 0"/>
			<startImageSliceId value="gui.button_left"/>
			<endImageSize value="6px 0"/>
			<endImageSliceId value="gui.button_right"/>
		</Profile>
		<Profile name="fs25_tcRewardLabel" extends="fs25_textDefault" with="anchorTopCenter">
			<size value="500px 30px"/>
			<position value="0px -526px"/>
			<textBold value="true"/>
			<textUpperCase value="true"/>
			<textAlignment value="center"/>
		</Profile>
		<Profile name="fs25_tcRewardValue" extends="fs25_textDefault" with="anchorTopCenter">
			<size value="500px 48px"/>
			<position value="0px -560px"/>
			<textSize value="34px"/>
			<textBold value="true"/>
			<textAlignment value="center"/>
			<textColor value="$preset_fs25_colorMainHighlight"/>
		</Profile>

		<Profile name="fs25_tcEmptyText" extends="fs25_textDefault" with="anchorMiddleCenter">
			<size value="560px 120px"/>
			<position value="0px 57px"/>
			<textSize value="26px"/>
			<textAlignment value="center"/>
			<textWrapWidth value="530px"/>
			<textMaxNumLines value="4"/>
		</Profile>
	</GUIProfiles>
</GUI>
